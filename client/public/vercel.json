{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rabbit-ride-backend.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://rabbit-ride-backend.onrender.com/api/auth/:path*"
    },
    {
      "source": "/register",
      "destination": "https://rabbit-ride-backend.onrender.com/api/auth/register"
    },
    {
      "source": "/login",
      "destination": "https://rabbit-ride-backend.onrender.com/api/auth/login"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(index.html|sw.js)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}

