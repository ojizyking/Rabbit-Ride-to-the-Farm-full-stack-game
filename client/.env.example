# =============================================================
# 🐇 RABBIT RIDE TO THE FARM - CLIENT ENVIRONMENT VARIABLES
# =============================================================
# Add these in Vercel Dashboard:
# Project Settings > Environment Variables
# =============================================================

# ── API BASE URL ────────────────────────────────────────────
# Set this to your Railway backend URL after deploying the server
# e.g. https://rabbit-farm-api.up.railway.app/api
VITE_API_URL=https://YOUR_RAILWAY_SERVICE_URL.up.railway.app/api

# ── CLERK AUTHENTICATION ────────────────────────────────────
# Get from https://dashboard.clerk.com > API Keys
# e.g. pk_test_... or pk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY

# ── APP META ────────────────────────────────────────────────
VITE_APP_NAME=Rabbit Ride to the Farm
VITE_APP_VERSION=1.0.0
