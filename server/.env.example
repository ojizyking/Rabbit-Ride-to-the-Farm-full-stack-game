# =============================================================
# 🐇 RABBIT RIDE TO THE FARM - SERVER ENVIRONMENT VARIABLES
# =============================================================
# Copy these values into Railway dashboard:
# Railway Project > Service > Variables tab
# =============================================================

# ── SERVER ─────────────────────────────────────────────────
PORT=5000

# ── DATABASE ───────────────────────────────────────────────
# Get a FREE MongoDB Atlas cluster at: https://cloud.mongodb.com
# Create cluster → Database Access → Network Access → Connection String
# Replace <password> with your etizzer_db_user password
MONGO_URI=mongodb+srv://etizzer_db_user:<password>@cluster0.mx0rtrg.mongodb.net/rabbit_farm?retryWrites=true&w=majority

# ── JWT AUTH ───────────────────────────────────────────────
# Use a long, random secret - generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_64_CHARS_OR_MORE

# ── CLERK AUTHENTICATION ───────────────────────────────────
# Get from https://dashboard.clerk.com > API Keys
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY
CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY

# ── SQUAD PAYMENT GATEWAY (by HabariPay / GTCO) ─────────
# Get from https://dashboard.squadco.com (or https://sandbox.squadco.com)
# Sandbox keys start with sandbox_sk_..., live keys start with sk_live_...
SQUAD_SECRET_KEY=sandbox_sk_YOUR_SQUAD_SECRET_KEY
SQUAD_ENV=sandbox

# ── CORS ───────────────────────────────────────────────────
# Set this to your Vercel frontend URL after deploying the client
# e.g. https://rabbit-ride.vercel.app
FRONTEND_URL=https://YOUR_APP_NAME.vercel.app

# ── ADMIN ACCESS ───────────────────────────────────────────
# Comma-separated emails that automatically have Admin role
ADMIN_EMAILS=etizzer@gmail.com,admin@rabbitride.farm

# ── NODE ENVIRONMENT ───────────────────────────────────────
NODE_ENV=production
